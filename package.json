{
  "name": "ework-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest src/__tests__/unit",
    "test:integration": "jest src/__tests__/integration",
    "ingest:all": "node scripts/ingest-all.cjs",
    "ingest:qa": "node scripts/ingest-qa.cjs",
    "test:qa": "node scripts/test-all-qa.cjs",
    "chat:rag": "node scripts/chat-rag.cjs",
    "chat:sum": "ts-node --project tsconfig.script.json scripts/chat-sum.ts",
    "db:schema": "node scripts/run-schema.cjs",
    "db:vector-fn": "node scripts/add-vector-function.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pg": "^8.23.1",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.5.4",
    "cohere-ai": "^8.0.0",
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^3.4.19",
    "uuid": "^14.0.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "ngrok": "^5.0.0-beta.2",
    "prettier": "^3.3.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
