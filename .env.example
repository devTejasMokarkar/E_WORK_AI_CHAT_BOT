# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE__DIRECT_CONNECTION=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Cohere API Key (get from https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your-cohere-api-key

# WhatsApp Business API Configuration (optional - for WhatsApp integration)
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token